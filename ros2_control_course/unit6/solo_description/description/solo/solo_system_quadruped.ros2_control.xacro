<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="solo_system_quadruped" params="name">

    <ros2_control name="solo_system_controller" type="system">

        <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="FL_HFE">
            <command_interface name="position">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="acceleration"/>
        </joint>
        <joint name="FL_KFE">
            <command_interface name="position">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="acceleration"/>
        </joint>
        <joint name="FR_HFE">
            <command_interface name="position">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="acceleration"/>
        </joint>
        <joint name="FR_KFE">
            <command_interface name="position">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="acceleration"/>
        </joint>
    
        <joint name="HL_HFE">
            <command_interface name="position">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="acceleration"/>
        </joint>
        <joint name="HL_KFE">
            <command_interface name="position">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="acceleration"/>
        </joint>
        <joint name="HR_HFE">
            <command_interface name="position">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="acceleration"/>
        </joint>
        <joint name="HR_KFE">
            <command_interface name="position">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="acceleration"/>
        </joint>

    </ros2_control>

    <!-- Gazebo ros2_control plugin -->

    <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find odri_controller)/config/joint_trajectory_controller_config.yaml</parameters>
        </plugin>
    </gazebo>

  </xacro:macro>

</robot>
